# Environment configuration for Reachy MCP Server
# Copy this to .env and customize for your setup

# ============================================================================
# Robot Connection
# ============================================================================
ROBOT_HOST=192.168.1.100
ROBOT_PORT=50051

# ============================================================================
# Safety Configuration
# ============================================================================
# Safety mode: strict (all checks), permissive (fewer confirmations), disabled (dev only)
SAFETY_MODE=strict

# Maximum commands per minute to prevent hardware damage
MAX_COMMANDS_PER_MINUTE=30

# Require user confirmation for potentially dangerous operations
REQUIRE_CONFIRMATION=true

# Workspace boundaries (meters from robot base)
WORKSPACE_X_MIN=-0.3
WORKSPACE_X_MAX=0.3
WORKSPACE_Y_MIN=-0.3
WORKSPACE_Y_MAX=0.3
WORKSPACE_Z_MIN=0.0
WORKSPACE_Z_MAX=0.5

# ============================================================================
# Vision Configuration
# ============================================================================
# Use local vision model (true) or cloud GPT-4V (false)
USE_LOCAL_VISION=false

# Local vision model (only used if USE_LOCAL_VISION=true)
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# OpenAI API key (required if USE_LOCAL_VISION=false)
OPENAI_API_KEY=sk-your-key-here

# ============================================================================
# Camera Configuration
# ============================================================================
# Enable camera functionality
ENABLE_CAMERA=true

# Face tracking mode: yolo, mediapipe, or disabled
FACE_TRACKING_MODE=yolo

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/reachy_mcp.log

# Audit log for all robot commands (security/debugging)
AUDIT_LOG=logs/robot_commands.jsonl

# Enable structured logging (JSON format)
STRUCTURED_LOGGING=false

# ============================================================================
# MCP Server Configuration
# ============================================================================
# Server transport: stdio (for local) or http (for remote)
MCP_TRANSPORT=stdio

# HTTP server settings (only used if MCP_TRANSPORT=http)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_AUTH_TOKEN=your-secret-token-here

# ============================================================================
# Performance Tuning
# ============================================================================
# Enable performance monitoring
ENABLE_METRICS=true

# Metrics collection interval (seconds)
METRICS_INTERVAL=60

# Maximum concurrent tool executions
MAX_CONCURRENT_TOOLS=3

# ============================================================================
# Development Settings
# ============================================================================
# Enable debug mode (verbose logging, no safety checks)
DEBUG_MODE=false

# Enable mock robot (no actual hardware required)
MOCK_ROBOT=false

# Enable MCP inspector integration
ENABLE_MCP_INSPECTOR=false
